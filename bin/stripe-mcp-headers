#!/bin/zsh
# headersHelper für den MCP-Server stripe (~/.claude.json): gibt den
# Stripe-Agent-Key aus der Keychain als Bearer-Header aus. Nicht von Hand
# ausführen – die Ausgabe enthält den Key. Doku: ~/Dev/nordwerk/ops/cloudflare-zugang.md
emulate -L zsh
set -eu

key="$(/usr/bin/security find-generic-password -a arne -s studio-nordwerk-stripe-agent -w 2>/dev/null)" || {
  print -u2 "stripe-mcp-headers: kein Key in der Keychain (Dienst studio-nordwerk-stripe-agent)"
  exit 1
}
/usr/bin/jq -cn --arg k "$key" '{Authorization: ("Bearer " + $k)}'
