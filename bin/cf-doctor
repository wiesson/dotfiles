#!/usr/bin/python3
"""Prüft den Cloudflare-Zugang für Claude Code – nur lesend, ändert nichts.

  cf-doctor          volle Prüfung (Token, Rechte je Bereich, wrangler, MCP)
  cf-doctor --quick  nur Keychain, Token-Status und MCP-Konfiguration

Exit 0 = alles ok, 1 = mindestens ein Fehler, 2 = nur Warnungen.
Das Token wird nie ausgegeben. Doku: ~/Dev/nordwerk/ops/cloudflare-zugang.md
"""
import datetime as dt
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

SERVICE = "studio-nordwerk-cloudflare-agent"
ACCOUNT_ID = "8ac65df3de87d8893e61f9ac14698a91"  # studio nordwerk
ZONE = "nordwerk.studio"
API = "https://api.cloudflare.com/client/v4"
MCP_URL = "https://mcp.cloudflare.com/mcp"
HELPER = os.path.expanduser("~/.local/bin/cf-mcp-headers")

results = {"ok": 0, "warn": 0, "fail": 0}


def report(level, label, detail=""):
    results[level] += 1
    tag = {"ok": "OK  ", "warn": "WARN", "fail": "FAIL"}[level]
    print(f"{tag} {label}" + (f" – {detail}" if detail else ""))


def keychain_token():
    try:
        out = subprocess.run(
            ["/usr/bin/security", "find-generic-password", "-a", "arne", "-s", SERVICE, "-w"],
            capture_output=True, text=True, timeout=10,
        )
    except subprocess.TimeoutExpired:
        return None
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


class ApiError(Exception):
    def __init__(self, status, errors):
        self.status = status
        self.errors = errors
        msg = "; ".join(f"{e.get('code')}: {e.get('message')}" for e in errors) or "keine Details"
        super().__init__(f"HTTP {status} ({msg})")


def http(url, token, payload=None, headers=None):
    # Eigener User-Agent: mcp.cloudflare.com blockt "Python-urllib" mit 403.
    h = {"Authorization": "Bearer " + token, "Accept": "application/json, text/event-stream",
         "User-Agent": "cf-doctor/1"}
    h.update(headers or {})
    data = None
    if payload is not None:
        h["Content-Type"] = "application/json"
        data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return resp.status, resp.read().decode(), resp.headers
    except urllib.error.HTTPError as err:
        body = err.read().decode(errors="replace")
        try:
            errors = json.loads(body).get("errors") or []
        except ValueError:
            errors = []
        raise ApiError(err.code, errors)


def api(path, token):
    _, body, _ = http(API + path, token)
    data = json.loads(body)
    if data.get("success") is False:
        raise ApiError(200, data.get("errors") or [])
    return data.get("result")


def check(label, permission, fn):
    """fn liefert einen Detailtext oder wirft; permission erscheint im Fehlerfall."""
    try:
        report("ok", label, fn() or "")
        return True
    except ApiError as err:
        hint = f" → Recht prüfen: {permission}" if err.status in (401, 403) or "9109" in str(err) or "10000" in str(err) else ""
        report("fail", label, f"{err}{hint}")
    except Exception as err:  # Netzwerk, Timeout, Parsing
        report("fail", label, f"{type(err).__name__}: {err}")
    return False


def check_mcp_config(token):
    try:
        cfg = json.load(open(os.path.expanduser("~/.claude.json")))
    except (OSError, ValueError) as err:
        report("fail", "MCP-Konfiguration", f"~/.claude.json nicht lesbar ({err})")
        return
    server = (cfg.get("mcpServers") or {}).get("cloudflare-api")
    if not server:
        report("fail", "MCP-Konfiguration", "kein User-Server 'cloudflare-api' in ~/.claude.json")
        return
    if any("authorization" == k.lower() for k in (server.get("headers") or {})):
        report("fail", "MCP-Konfiguration", "statischer Authorization-Header in ~/.claude.json – entfernen, headersHelper nutzen")
        return
    if server.get("headersHelper") != HELPER:
        report("warn", "MCP-Konfiguration", "cloudflare-api nutzt noch OAuth (kein headersHelper) – siehe ops/cloudflare-zugang.md")
        return
    try:
        out = subprocess.run([HELPER], capture_output=True, text=True, timeout=10)
        headers = json.loads(out.stdout) if out.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        headers = {}
    if headers.get("Authorization") == "Bearer " + token:
        report("ok", "MCP-Konfiguration", "headersHelper liefert das Keychain-Token")
    else:
        report("fail", "MCP-Konfiguration", f"{HELPER} liefert keinen passenden Authorization-Header")


def check_token(token):
    def verify():
        result = api("/user/tokens/verify", token)
        if result.get("status") != "active":
            raise RuntimeError(f"Status {result.get('status')}")
        expires = result.get("expires_on")
        if not expires:
            return "aktiv, ohne Ablaufdatum"
        left = dt.datetime.fromisoformat(expires.replace("Z", "+00:00")) - dt.datetime.now(dt.timezone.utc)
        if left < dt.timedelta(days=14):
            report("warn", "Token läuft bald ab", f"noch {left.days} Tage ({expires})")
        return f"aktiv, läuft ab {expires[:10]}"

    return check("Token gültig", "Token in der Keychain ersetzen", verify)


def full(token):
    acc = f"/accounts/{ACCOUNT_ID}"
    state = {}

    check("User-Identität", "User → User Details → Read",
          lambda: api("/user", token).get("email", "?"))

    def accounts():
        names = [a["name"] for a in api("/accounts?per_page=50", token)]
        if not any(a == "studio nordwerk" for a in names):
            raise RuntimeError(f"studio nordwerk fehlt (sichtbar: {', '.join(names) or 'nichts'})")
        return ", ".join(names)
    check("Account sichtbar", "Account → Account Settings → Read", accounts)

    def scripts():
        items = api(f"{acc}/workers/scripts", token)
        state["scripts"] = {s["id"]: s.get("tag") for s in items}
        return f"{len(items)} Worker"
    check("Workers Scripts", "Account → Workers Scripts → Edit", scripts)

    def builds():
        tag = (state.get("scripts") or {}).get("jobs")
        if not tag:
            api(f"{acc}/builds/tokens", token)
            return "Build-Tokens lesbar"
        triggers = api(f"{acc}/builds/workers/{tag}/triggers", token) or []
        return f"Worker jobs: {len(triggers)} Trigger"
    check("Workers Builds", "Account → Workers Builds Configuration (Workers CI) → Edit", builds)

    check("Custom Domains", "Account → Workers Scripts → Edit",
          lambda: f"{len(api(f'{acc}/workers/domains', token) or [])} Domains")

    check("Email-Zieladressen", "Account → Email Routing Addresses → Edit",
          lambda: f"{len(api(f'{acc}/email/routing/addresses', token) or [])} Adressen")

    def zones():
        items = api(f"/zones?account.id={ACCOUNT_ID}&per_page=50", token)
        state["zone"] = next((z["id"] for z in items if z["name"] == ZONE), None)
        if not state["zone"]:
            raise RuntimeError(f"{ZONE} nicht sichtbar")
        return f"{len(items)} Zonen"
    if not check("Zonen", "Zone → Zone → Read (Zone Resources: alle Zonen von studio nordwerk)", zones):
        return
    z = f"/zones/{state['zone']}"

    def routing():
        r = api(f"{z}/email/routing", token)
        return f"{ZONE}: {'an' if r.get('enabled') else 'aus'}, Subaddressing {'an' if r.get('support_subaddress') else 'aus'}"
    check("Email-Routing-Einstellungen", "Zone → Zone Settings → Edit", routing)
    check("Email-Routing-Regeln", "Zone → Email Routing Rules → Edit",
          lambda: f"{len(api(f'{z}/email/routing/rules', token) or [])} Regeln")
    check("DNS", "Zone → DNS → Edit",
          lambda: api(f"{z}/dns_records?per_page=1", token) is not None and "lesbar")
    check("Workers Routes", "Zone → Workers Routes → Edit",
          lambda: f"{len(api(f'{z}/workers/routes', token) or [])} Routen")
    check("Email Sending", "Email Sending → Edit",
          lambda: f"{len(api(f'{z}/email/sending/subdomains', token) or [])} Sende-Subdomains")

    def wrangler():
        env = {k: v for k, v in os.environ.items()
               if k not in ("CLOUDFLARE_API_KEY", "CLOUDFLARE_EMAIL", "CF_API_KEY", "CF_EMAIL")}
        env.update(CLOUDFLARE_API_TOKEN=token, CLOUDFLARE_ACCOUNT_ID=ACCOUNT_ID)
        out = subprocess.run(["npx", "--no-install", "wrangler", "whoami"], env=env,
                             capture_output=True, text=True, timeout=60)
        text = out.stdout + out.stderr
        if out.returncode != 0:
            raise RuntimeError(text.strip().splitlines()[-1] if text.strip() else f"Exit {out.returncode}")
        if "API Token" not in text and "api token" not in text.lower():
            raise RuntimeError("wrangler nutzt nicht das Token")
        return "API-Token wird verwendet"
    check("wrangler whoami (via Token)", "User → User Details → Read", wrangler)

    def mcp():
        init_payload = {
            "jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                       "clientInfo": {"name": "cf-doctor", "version": "1"}},
        }
        _, body, headers = http(MCP_URL, token, init_payload)
        init = parse_rpc(body, 1)
        extra = {"MCP-Protocol-Version": init["result"]["protocolVersion"]}
        if headers.get("Mcp-Session-Id"):
            extra["Mcp-Session-Id"] = headers["Mcp-Session-Id"]
        http(MCP_URL, token, {"jsonrpc": "2.0", "method": "notifications/initialized"}, extra)
        _, body, _ = http(MCP_URL, token, {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}, extra)
        tools = parse_rpc(body, 2)["result"]["tools"]
        if not tools:
            raise RuntimeError("keine Werkzeuge")
        return "Werkzeuge: " + ", ".join(t["name"] for t in tools)
    check("MCP mcp.cloudflare.com mit Token", "Token-Rechte (User Details + Account Settings Read)", mcp)


def parse_rpc(body, rpc_id):
    text = body.strip()
    if text.startswith("{"):
        msg = json.loads(text)
    else:
        msgs = [json.loads(line[5:].strip()) for line in text.splitlines()
                if line.startswith("data:") and line[5:].strip().startswith("{")]
        msg = next((m for m in msgs if m.get("id") == rpc_id), {})
    if "error" in msg or "result" not in msg:
        raise RuntimeError(f"RPC-Fehler: {msg.get('error') or 'keine Antwort'}")
    return msg


def main():
    quick = "--quick" in sys.argv[1:]
    token = keychain_token()
    if not token:
        report("fail", "Keychain", f"kein Eintrag '{SERVICE}' – Token anlegen, siehe ops/cloudflare-zugang.md")
        sys.exit(1)
    report("ok", "Keychain", f"Eintrag '{SERVICE}' vorhanden")
    token_ok = check_token(token)
    check_mcp_config(token)
    if token_ok and not quick:
        full(token)
    print(f"\n{results['ok']} ok, {results['warn']} Warnungen, {results['fail']} Fehler")
    sys.exit(1 if results["fail"] else 2 if results["warn"] else 0)


if __name__ == "__main__":
    main()
