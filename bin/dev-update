#!/bin/zsh

# Keep the global JavaScript development toolchain current.
# Project dependencies are intentionally not modified.

set -u

mode="update"
case "${1:-}" in
  "") ;;
  --check) mode="check" ;;
  -h|--help)
    cat <<'EOF'
Usage: dev-update [--check]

Without arguments:
  - upgrades the global Vite+ CLI
  - sets the Vite+ global Node.js default to the latest LTS
  - updates Vite+-managed global packages
  - updates globally managed agent skills
  - runs Vite+ diagnostics

--check only reports Vite+ and global-package updates. The Skills CLI does
not currently offer a non-mutating update check.
EOF
    exit 0
    ;;
  *)
    print -u2 "Unknown option: $1"
    print -u2 "Usage: dev-update [--check]"
    exit 2
    ;;
esac

if ! command -v vp >/dev/null 2>&1; then
  print -u2 "dev-update: vp not found in PATH"
  exit 127
fi

failures=0
run_step() {
  local title="$1"
  shift
  print
  print "==> $title"
  if ! "$@"; then
    print -u2 "FAILED: $title"
    (( failures += 1 ))
  fi
}

if [[ "$mode" == "check" ]]; then
  run_step "Check Vite+ CLI" vp upgrade --check
  run_step "Check global packages" vp outdated -g
  print
  print "Note: skills has no check-only command; run dev-update to update them."
else
  run_step "Upgrade Vite+ CLI" vp upgrade
  run_step "Set the global Node.js default to LTS" vp env default lts
  run_step "Update Vite+-managed global packages" vp update -g

  if command -v skills >/dev/null 2>&1; then
    run_step "Update globally managed agent skills" skills update -g -y
  else
    print -u2 "SKIPPED: skills not found in PATH"
    (( failures += 1 ))
  fi

  run_step "Verify Vite+ environment" vp env doctor
  run_step "Verify global package status" vp outdated -g
fi

print
if (( failures > 0 )); then
  print -u2 "dev-update completed with $failures failed step(s)."
  exit 1
fi

print "dev-update completed successfully."
