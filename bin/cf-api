#!/bin/zsh
# Cloudflare-REST mit dem Agent-Token aus der Keychain (Ausweichweg, wenn MCP hakt).
#   cf-api GET /accounts/{account}/workers/scripts
#   cf-api GET '/zones/{zone:nordwerk.studio}/email/routing/rules'
#   cf-api PATCH '/zones/{zone:nordwerk.studio}/email/routing' '{"support_subaddress":true}'
#   cf-api POST <pfad> @body.json      (oder "-" für Body von stdin)
# {account} = studio nordwerk, {zone:<name>} wird zur Zone-ID aufgelöst.
# Exit 0 nur bei HTTP < 400 und success != false. Das Token erscheint nie in
# Argumenten oder Ausgabe (Header kommt über eine Prozess-Substitution).
emulate -L zsh
set -eu
setopt pipefail

API=https://api.cloudflare.com/client/v4
ACCOUNT_ID=8ac65df3de87d8893e61f9ac14698a91 # studio nordwerk

usage() {
  print -u2 "Aufruf: cf-api GET|POST|PUT|PATCH|DELETE <pfad> [json | @datei | -]"
  exit 64
}
(( $# >= 2 && $# <= 3 )) || usage
method=${1:u}
api_path=$2
body=${3-}
case $method in GET|POST|PUT|PATCH|DELETE) ;; *) usage ;; esac
[[ $api_path == /* ]] || usage
if [[ $method == GET && -n $body ]]; then
  print -u2 "cf-api: GET nimmt keinen Body"
  exit 64
fi

token="$(/usr/bin/security find-generic-password -a arne -s studio-nordwerk-cloudflare-agent -w 2>/dev/null)" || {
  print -u2 "cf-api: kein Token in der Keychain (Dienst studio-nordwerk-cloudflare-agent)"
  exit 78
}

call() { # <method> <url> [curl-args …] → Body, letzte Zeile HTTP-Status
  local m=$1 u=$2
  shift 2
  /usr/bin/curl -sS --max-time 30 -X "$m" \
    -H @<(print -r -- "Authorization: Bearer $token") \
    -H 'Content-Type: application/json' \
    "$@" -w '\n%{http_code}' "$u"
}

while [[ $api_path =~ '\{zone:([^}]+)\}' ]]; do
  zone_name=$match[1]
  zone_id="$(call GET "$API/zones?name=$zone_name&account.id=$ACCOUNT_ID" | sed '$d' | /usr/bin/jq -r '.result[0].id // empty')"
  if [[ -z $zone_id ]]; then
    print -u2 "cf-api: Zone $zone_name nicht gefunden (oder Recht Zone:Read fehlt)"
    exit 1
  fi
  api_path=${api_path//\{zone:$zone_name\}/$zone_id}
done
api_path=${api_path//\{account\}/$ACCOUNT_ID}

data=()
case $body in
  '') ;;
  -) data=(--data-binary @-) ;;
  *) data=(--data-binary "$body") ;;
esac

response="$(call "$method" "$API$api_path" "${data[@]}")"
code=${response##*$'\n'}
json=${response%$'\n'*}

if print -r -- "$json" | /usr/bin/jq -e . >/dev/null 2>&1; then
  print -r -- "$json" | /usr/bin/jq .
  if [[ "$(print -r -- "$json" | /usr/bin/jq -r 'if type == "object" then (.success // true) else true end')" == false ]]; then
    exit 1
  fi
else
  print -r -- "$json"
fi
(( code < 400 )) || { print -u2 "cf-api: HTTP $code"; exit 1 }
