#!/bin/zsh
# headersHelper für den MCP-Server cloudflare-api (~/.claude.json).
# Gibt {"Authorization":"Bearer <token>"} aus; Claude Code ruft das bei jedem
# Verbindungsaufbau und nach 401/403 erneut auf. Nicht von Hand ausführen –
# die Ausgabe enthält das Token.
emulate -L zsh
set -eu

token="$(/usr/bin/security find-generic-password -a arne -s studio-nordwerk-cloudflare-agent -w 2>/dev/null)" || {
  print -u2 "cf-mcp-headers: kein Token in der Keychain (Dienst studio-nordwerk-cloudflare-agent)"
  exit 1
}
/usr/bin/jq -cn --arg t "$token" '{Authorization: ("Bearer " + $t)}'
