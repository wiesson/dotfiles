#    MODERN TOOLS
# ===================
# fzf - fuzzy finder (Ctrl+R for history, Ctrl+T for files)
export FZF_CTRL_T_COMMAND="find . -type f -not -path '*/OrbStack/*' -not -path '*/.git/*' 2>/dev/null"
(( $+commands[fzf] )) && source <(fzf --zsh)

# zoxide - smart cd that learns your habits
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# eza - modern ls with git status
if (( $+commands[eza] )); then
  alias ls='eza --icons'
  alias ll='eza -la --icons --git'
  alias tree='eza --tree'
fi

# Mac wachhalten, solange claude/codex laufen (caffeinate -i = kein Idle-Sleep, -s = kein System-Sleep am Netzteil)
if (( $+commands[caffeinate] )); then
  claude() { caffeinate -is command claude "$@"; }
  codex()  { caffeinate -is command codex "$@"; }
fi

