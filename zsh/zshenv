
# Vite+ bin (https://viteplus.dev)
[[ -r "$HOME/.vite-plus/env" ]] && . "$HOME/.vite-plus/env"

# Keep the portless proxy off 80/443 so the exactag Caddy container can bind them.
export PORTLESS_PORT=1355

# agent-browser: Daemon nach 5 min Leerlauf beenden, damit kein Chrome hängen bleibt.
export AGENT_BROWSER_IDLE_TIMEOUT_MS=300000
